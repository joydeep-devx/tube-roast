# Copy this file to .env and adjust values. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the API listens on. The Vite dev server proxies /api to this port.
PORT=5000

# MongoDB connection string (Atlas: Database > Connect > Drivers).
# Keep the real one only in .env: it contains your database password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Google OAuth client (Google Cloud > Google Auth Platform > Clients > Web application).
# The secret is shown only once when the client is created.
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Must exactly match an Authorized redirect URI on the client. Goes through the Vite proxy in development.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Where the React app runs.
CLIENT_URL=http://localhost:5173

# Random string of at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<generate-a-random-secret>
